# NoblePort supervisor stack — local development defaults

# Postgres truth layer. Use postgresql:// for production.
# For tests / local without Docker, comment this out and the app falls back
# to a SQLite file at ./nobleport.db.
DATABASE_URL=postgresql://nobleport:nobleport@postgres:5432/nobleport

# Async Redis event bus. Leave unset to disable Redis (NullEventBus); /ready
# will then skip the Redis check.
REDIS_URL=redis://redis:6379/0

# Channel name agent lifecycle / step events are published on.
AGENT_EVENT_CHANNEL=agent.events

# Allowlisted commands for the tool sandbox (comma-separated executable
# basenames). Anything else is rejected with SandboxRejected.
SANDBOX_ALLOWED_COMMANDS=pytest,flake8

# Wall-clock timeout for sandboxed commands.
SANDBOX_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Hermes channel drivers (Slack / WhatsApp / Web Chat)
# ---------------------------------------------------------------------------
# All channel traffic routes through the Hermes Gateway -> NoblePort Core.
# Leave a channel's tokens unset to leave that channel un-wired. NEVER commit
# real secrets — these are placeholders for a local .env only.

# Shared: keyed hash salt so audit/log records carry only hashed phone refs,
# never raw numbers. Set a long random value in production.
HERMES_PHONE_HASH_SALT=

# Slack (operator-facing, Socket Mode). App-level token needs connections:write.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated channel IDs (C…) permitted for the bot. Unset => DM-only.
SLACK_ALLOWED_CHANNELS=
# Comma-separated workspace/team IDs (T…) permitted. Unset => no team filter.
SLACK_ALLOWED_TEAM_IDS=
SLACK_DM_ONLY_IF_NO_ALLOWLIST=true

# WhatsApp (customer-facing, Twilio). Consent-gated + signature-verified.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=whatsapp:+15551234567
TWILIO_VALIDATE_SIGNATURES=true
# Public URL Twilio signs against. Set when behind a proxy / different host.
TWILIO_PUBLIC_BASE_URL=
# Only trust X-Forwarded-* when the app sits behind a proxy you control.
TWILIO_TRUST_FORWARDED=false

# Web Chat (public, read-only). Session-scoped bounded rate limits.
WEB_RATE_PER_MIN=5
WEB_RATE_PER_HOUR=30
WEB_SESSION_IDLE_SECONDS=3600
# Set false only for local http testing; keep true in production (HTTPS).
WEB_SECURE_COOKIES=true
