# NoblePort supervisor stack — local development defaults

# Postgres truth layer. Use postgresql:// for production.
# For tests / local without Docker, comment this out and the app falls back
# to a SQLite file at ./nobleport.db.
DATABASE_URL=postgresql://nobleport:nobleport@postgres:5432/nobleport

# Async Redis event bus. Leave unset to disable Redis (NullEventBus); /ready
# will then skip the Redis check.
REDIS_URL=redis://redis:6379/0

# Channel name agent lifecycle / step events are published on.
AGENT_EVENT_CHANNEL=agent.events

# Allowlisted commands for the tool sandbox (comma-separated executable
# basenames). Anything else is rejected with SandboxRejected.
SANDBOX_ALLOWED_COMMANDS=pytest,flake8

# Wall-clock timeout for sandboxed commands.
SANDBOX_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Stephanie.ai Live Voice Launch Gate v1
# ---------------------------------------------------------------------------
# Each variable below maps to a launch gate. /metrics/gates returns PASS only
# when the gate is fully configured. Missing => FAIL or DEGRADED. Do NOT
# report PASS unless the underlying capability is actually available.

# Voice gate. Set both providers AND their API key env vars. Example
# providers: deepgram, openai, elevenlabs, azure. The expected key env var
# is "<PROVIDER_UPPER>_API_KEY".
STT_PROVIDER=
TTS_PROVIDER=
# DEEPGRAM_API_KEY=...
# ELEVENLABS_API_KEY=...

# Avatar gate. PASS requires both. URL alone is DEGRADED (idle-only).
AVATAR_ASSET_URL=
AVATAR_PROVIDER=

# WebSocket gate. Public URL the client connects to. wss:// for production.
PUBLIC_WS_URL=
